rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función para validar si el usuario autenticado es administrador (Presidente)
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == "8BgNvErBfxcEyKgVbNO6S2Y1vcH2"
      );
    }

    // Reglas para la colección de jugadores
    match /jugadores/{jugadorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reglas para la colección de partidos y sus subcolecciones (como pdf_acta)
    match /partidos/{partidoId} {
      allow read: if true;
      allow write: if isAdmin();

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Reglas para la colección de entrenamientos
    match /entrenamientos/{entrenamientoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reglas para la colección de configuración (temporada activa)
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
