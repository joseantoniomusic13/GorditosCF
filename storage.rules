rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Función para validar si el usuario autenticado es administrador (Presidente)
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == "8BgNvErBfxcEyKgVbNO6S2Y1vcH2"
      );
    }

    // Reglas para la carpeta de fotos de jugadores
    match /jugadores/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reglas para las actas oficiales de los partidos (PDFs)
    match /actas_partidos/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

